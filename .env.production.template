# ==========================================
# PIXELSPOT PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env.production and fill in all values
# DO NOT commit .env.production to Git

# ==========================================
# APPLICATION SETTINGS
# ==========================================

# Environment (always production for deployment)
NODE_ENV=production

# Server port (default: 5000 - do not change unless necessary)
PORT=5000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# PostgreSQL Database Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 
# Option 1: Neon PostgreSQL (Recommended for production)
# Get from: https://console.neon.tech
# Example: postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/pixelspot?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database

# ==========================================
# FIREBASE AUTHENTICATION
# ==========================================
# Get these from: Firebase Console > Project Settings > General
# URL: https://console.firebase.google.com

# Firebase API Key
VITE_FIREBASE_API_KEY=AIza...

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your-project-id

# Firebase App ID
VITE_FIREBASE_APP_ID=1:123...

# ==========================================
# AWS SES (EMAIL SERVICE)
# ==========================================
# Used for: Email OTP verification, booking notifications
# Get from: AWS Console > SES > SMTP Settings
# Region: ap-south-1 (Mumbai)
# URL: https://console.aws.amazon.com/ses

# AWS SES SMTP Username
AWS_SES_SMTP_USER=AKIA...

# AWS SES SMTP Password
AWS_SES_SMTP_PASSWORD=your-smtp-password

# ==========================================
# COMBIRDS SMS SERVICE (India)
# ==========================================
# Used for: Mobile OTP verification
# Get from: ComBirds Dashboard
# URL: https://www.combirds.com

# ComBirds API Key
COMBIRDS_API_KEY=your-api-key

# ComBirds User ID
COMBIRDS_USER_ID=your-user-id

# ComBirds Password
COMBIRDS_PASSWORD=your-password

# ComBirds Sender ID (DLT approved header, max 6 chars)
# Example: PIXLSP, PXLSPT
COMBIRDS_HEADER=PIXLSP

# ComBirds OTP Template ID (DLT registered template)
# Default template: "Your Pixelspot OTP is {#var#}. Valid for 10 minutes."
# If you have a custom DLT template, replace this ID
COMBIRDS_OTP_TEMPLATE_ID=1707168926925165526

# ==========================================
# GOOGLE MAPS API
# ==========================================
# Used for: Screen location mapping, campaign area selection
# Get from: Google Cloud Console > APIs & Services > Credentials
# Enable: Maps JavaScript API, Geocoding API, Places API
# URL: https://console.cloud.google.com

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=AIza...

# ==========================================
# OPENAI API (AI Campaign Advisor)
# ==========================================
# Used for: AI-powered campaign suggestions and recommendations
# Get from: OpenAI Platform > API Keys
# URL: https://platform.openai.com/api-keys

# OpenAI API Key
OPENAI_API_KEY=sk-...

# ==========================================
# STRIPE PAYMENT GATEWAY
# ==========================================
# Used for: Payment processing, subscription management
# Get from: Stripe Dashboard > Developers > API Keys
# URL: https://dashboard.stripe.com/apikeys
# IMPORTANT: Use LIVE keys for production, not TEST keys

# Stripe Secret Key (server-side)
# Format: sk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Stripe Publishable Key (client-side)
# Format: pk_live_...
VITE_STRIPE_PUBLIC_KEY=pk_live_...

# ==========================================
# REPLIT OBJECT STORAGE (If migrating from Replit)
# ==========================================
# Only needed if you're using Replit Object Storage
# If not using, leave these commented out

# DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
# PUBLIC_OBJECT_SEARCH_PATHS=public
# PRIVATE_OBJECT_DIR=.private

# ==========================================
# SESSION SECURITY
# ==========================================
# Session secret for Express session encryption
# Generate a secure random string (64+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# ==========================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# ==========================================

# Domain configuration (used for CORS and email links)
# Example: https://pixelspot.in
# DOMAIN_URL=https://yourdomain.com

# Admin email for system notifications
# ADMIN_EMAIL=admin@pixelspot.in

# Customer support email
# SUPPORT_EMAIL=support@pixelspot.in

# ==========================================
# VERIFICATION CHECKLIST
# ==========================================
# Before deploying, verify all required variables are set:
#
# [ ] NODE_ENV=production
# [ ] PORT=5000
# [ ] DATABASE_URL (PostgreSQL connection string)
# [ ] VITE_FIREBASE_API_KEY
# [ ] VITE_FIREBASE_PROJECT_ID
# [ ] VITE_FIREBASE_APP_ID
# [ ] AWS_SES_SMTP_USER
# [ ] AWS_SES_SMTP_PASSWORD
# [ ] COMBIRDS_API_KEY
# [ ] COMBIRDS_USER_ID
# [ ] COMBIRDS_PASSWORD
# [ ] COMBIRDS_HEADER
# [ ] VITE_GOOGLE_MAPS_API_KEY
# [ ] OPENAI_API_KEY
# [ ] STRIPE_SECRET_KEY
# [ ] VITE_STRIPE_PUBLIC_KEY
# [ ] SESSION_SECRET (generated random string)
#
# ==========================================
# SECURITY NOTES
# ==========================================
# 
# 1. Never commit .env.production to version control
# 2. Add .env.production to .gitignore
# 3. Use different API keys for staging and production
# 4. Rotate SESSION_SECRET periodically
# 5. Use Stripe LIVE keys only in production
# 6. Keep this file permissions restricted: chmod 600 .env.production
# 7. Never share API keys or credentials
# 8. Use environment variable management tools for team access
#
# ==========================================
