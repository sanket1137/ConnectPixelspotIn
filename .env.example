# ==============================================================================
# Pixelspot - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Use the SAME .env file for both development and production initially
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-super-secret-session-key-change-this

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Format: postgresql://username:password@host:port/database
# Example: postgresql://pixelspot_user:secure_password@your-server.com:5432/pixelspot_db

DATABASE_URL=postgresql://username:password@localhost:5432/pixelspot

# Individual PostgreSQL credentials (optional, used by some tools)
PGHOST=localhost
PGPORT=5432
PGUSER=username
PGPASSWORD=password
PGDATABASE=pixelspot

# ------------------------------------------------------------------------------
# Firebase Authentication Configuration
# ------------------------------------------------------------------------------
# Firebase Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Admin SDK Service Account
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Firebase Client Configuration (for frontend)
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:123456789:web:abcdefghijk

# ------------------------------------------------------------------------------
# Google OAuth Configuration (Server-side)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# ------------------------------------------------------------------------------
# Google Maps API
# ------------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# AWS SES (Email Service)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_REGION=ap-south-1

# AWS SES SMTP Credentials (if using SMTP instead of API)
AWS_SES_SMTP_USER=your-smtp-username
AWS_SES_SMTP_PASSWORD=your-smtp-password

# ------------------------------------------------------------------------------
# ComBirds SMS API (Indian SMS Gateway)
# ------------------------------------------------------------------------------
COMBIRDS_API_KEY=your-combirds-api-key
COMBIRDS_USER_ID=your-combirds-user-id
COMBIRDS_PASSWORD=your-combirds-password
COMBIRDS_HEADER=PIXSPT
COMBIRDS_OTP_TEMPLATE_ID=your-dlt-template-id

# ------------------------------------------------------------------------------
# OpenAI API (AI Campaign Advisor)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# Stripe Payment Gateway
# ------------------------------------------------------------------------------
# Production Keys
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_STRIPE_PUBLIC_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Testing Keys (for development/testing)
TESTING_STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TESTING_VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# Replit Object Storage (optional, for Replit deployments)
# ------------------------------------------------------------------------------
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
PUBLIC_OBJECT_SEARCH_PATHS=/public
PRIVATE_OBJECT_DIR=/.private

# ------------------------------------------------------------------------------
# Mapbox (optional, if using Mapbox instead of Google Maps)
# ------------------------------------------------------------------------------
# VITE_MAPBOX_TOKEN=pk.eyJ1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==============================================================================
# DEPLOYMENT NOTES
# ==============================================================================
# 1. Never commit this .env file to version control
# 2. For production, use strong random values for SESSION_SECRET
# 3. Ensure DATABASE_URL points to your actual PostgreSQL server
# 4. Firebase private key must contain actual newlines (\n), not escaped
# 5. Update all VITE_* variables - they are embedded in frontend at build time
# 6. For Docker deployment, mount this file or use docker-compose env_file
# ==============================================================================
